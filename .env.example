APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///./teacher_intelligence.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15
ACCESS_TOKEN_EXPIRE_MINUTES=720
DEMO_TEACHER_EMAIL=teacher@example.com
DEMO_TEACHER_NAME=Teacher
DEMO_TEACHER_PASSWORD=Teacher123!
SCHOOL_NAME=My School
ACADEMIC_YEAR=2026/27

MAX_BATCH_FILES=150

AI_BATCH_WORKERS=6

AI_MAX_RETRIES=2

AI_RETRY_BACKOFF_SECONDS=1

IDENTITY_AUTO_ACCEPT_THRESHOLD=0.92

QUESTION_AUTO_ACCEPT_THRESHOLD=0.90

ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,capacitor://localhost
PUBLIC_APP_URL=http://127.0.0.1:8000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=ati_session
MAX_LOGIN_ATTEMPTS=7
LOGIN_WINDOW_SECONDS=300
SIGNUP_ENABLED=true
ALLOW_DEMO_ACCOUNT=true

SESSION_COOKIE_SAMESITE=lax
OFFLINE_SYNC_BATCH_SIZE=100
SYNC_OPERATION_RETENTION_DAYS=30
